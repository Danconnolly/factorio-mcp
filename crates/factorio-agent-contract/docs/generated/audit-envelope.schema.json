{"$defs":{"ActionId":{"description":"Stable ID for an action lifecycle request.","type":"string"},"ActionState":{"description":"The complete lifecycle vocabulary. Phase 0 records lifecycle only; it performs no mutation.","enum":["accepted","running","succeeded","rejected","cancelled","failed"],"type":"string"},"AuditRecord":{"description":"Phase-1 audit records retain read metadata and durable bridge-owned action receipts.","oneOf":[{"properties":{"action_id":{"$ref":"#/$defs/ActionId"},"game_tick":{"format":"uint64","minimum":0,"type":"integer"},"kind":{"const":"lifecycle","type":"string"},"state":{"$ref":"#/$defs/ActionState"}},"required":["kind","action_id","state","game_tick"],"type":"object"},{"$ref":"#/$defs/ObservationRecord","properties":{"kind":{"const":"observation","type":"string"}},"required":["kind"],"type":"object"},{"properties":{"kind":{"const":"mutation","type":"string"},"receipt":true},"required":["kind","receipt"],"type":"object"}]},"Capability":{"description":"Public capabilities available during the current Phase-1 primitive slice.","enum":["get_capability_contract","get_actor_status","scan_local","scan_charted","get_entity","get_action_record","walk_to","stop","mine","get_action"],"type":"string"},"ObservationRecord":{"description":"Audit event emitted for a bounded read-only result.","properties":{"capability":{"$ref":"#/$defs/Capability"},"game_tick":{"format":"uint64","minimum":0,"type":"integer"},"provenance":{"$ref":"#/$defs/Provenance"},"result_count":{"format":"uint32","minimum":0,"type":"integer"},"truncated":{"type":"boolean"}},"required":["capability","game_tick","provenance","result_count","truncated"],"type":"object"},"Provenance":{"description":"Why an observation is allowed. Clients must retain this with every record.","enum":["character_local","force_charted","permitted_direct_interaction","force_statistics"],"type":"string"}},"$schema":"https://json-schema.org/draft/2020-12/schema","description":"The append-only envelope. Only t